<Mission xmlns="http://ProjectMalmo.microsoft.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <About>
        <Summary>Find the goal!</Summary>
    </About>

    <ModSettings>
        <MsPerTick>5</MsPerTick>
    </ModSettings>

    <ServerSection>
        <ServerInitialConditions>
            <Time>
                <StartTime>6000</StartTime>
                <AllowPassageOfTime>false</AllowPassageOfTime>
            </Time>
            <Weather>clear</Weather>
            <AllowSpawning>false</AllowSpawning>
        </ServerInitialConditions>
        <ServerHandlers>
<!--            <BiomeGenerator forceReset="true" biome="3"/>-->
            <DefaultWorldGenerator forceReset="true"/>
            <NavigationDecorator/>

            <ServerQuitFromTimeUp timeLimitMs="60000" description="out_of_time"/>
            <ServerQuitWhenAnyAgentFinishes/>
        </ServerHandlers>
    </ServerSection>

    <AgentSection mode="Survival">
        <Name>Agent1</Name>
        <AgentStart>
            <LowLevelInputs>true</LowLevelInputs>
            <Inventory>
                <!-- 1 ender pearl -->
                <InventoryObject slot="0" type="ender_pearl" quantity="1"  metadata="0"/>
                <!-- stack of blocks (stone) -->
                <InventoryObject slot="1" type="stone" quantity="64"  metadata="0"/>
                <!-- 1 speed potion -->
<!--                <InventoryObject slot="2" type="splash_potion" quantity="1" metadata="0"/>-->
                <InventoryObject slot="8" type="compass" quantity="1" metadata="0"/>
            </Inventory>
        </AgentStart>
        <AgentHandlers>
            <VideoProducer want_depth="true">
<!--                <Width>64</Width>-->
<!--                <Height>64</Height>-->
<!--                <Width>640</Width>-->
<!--                <Height>360</Height>-->
                <Width>360</Width>
                <Height>360</Height>
            </VideoProducer>

            <ObservationFromBlocksStream/>
            <ObservationFromBlockStateRegistry/>
            <ObservationFromFullStats/>
<!--            <ContinuousMovementCommands turnSpeedDegs="180">-->
<!--            </ContinuousMovementCommands>-->
            <HumanLevelCommands/>
            <RewardForTimeTaken initialReward="-0.01" delta="0" density="PER_TICK"/>
            <RewardForDistanceTraveledToCompassTarget rewardPerBlock="0.009" density="PER_TICK"/>
<!--            TODO will not work-->


            <RewardForTouchingBlockType>
                <Block type="diamond_block" reward="0.5"/>
            </RewardForTouchingBlockType>
            <AgentQuitFromTouchingBlockType>
                <Block type="diamond_block" description="found_goal"/>
            </AgentQuitFromTouchingBlockType>
            <RewardForMissionEnd rewardForDeath="-1">
                <Reward description="found_goal" reward="0.5"/>
<!--                <Reward description="out_of_time" reward="-0.1"/>-->
            </RewardForMissionEnd>
        </AgentHandlers>
    </AgentSection>
</Mission>
